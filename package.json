{
  "name": "pypackages.com",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "postinstall": "husky install",
    "lint": "eslint src/**/*.vue src/**/*.js",
    "format": "prettier --write ."
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vue": "^2.0.2",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "vite": "^7.1.9",
    "vue-eslint-parser": "^10.2.0"
  },
  "packageManager": "yarn@4.10.3",
  "lint-staged": {
    "src/**/*.{js,scss,vue}": [
      "yarn eslint --fix"
    ],
    "src/**/*.{md}": [
      "yarn prettier --write"
    ]
  },
  "type": "module"
}
